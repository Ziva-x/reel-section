      </svg>

      {% if block.settings.button_text != blank %}
        <span class="reel-whatsapp-label">{{ block.settings.button_text }}</span>
      {% endif %}
    </a>
  </div>

  <style>
    .reel-whatsapp-float-container {
      position: fixed;
      bottom: var(--wa-bottom, 24px);
      z-index: 2147483640;
      display: flex;
      flex-direction: column;
      gap: 10px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
    .reel-whatsapp-pos-right {
      right: var(--wa-side, 24px);
      left: auto;
      align-items: flex-end;
    }
    .reel-whatsapp-pos-left {
      left: var(--wa-side, 24px);
      right: auto;
      align-items: flex-start;
    }

    .reel-whatsapp-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background-color: var(--wa-bg, #25D366);
      color: var(--wa-text, #ffffff);
      padding: 12px 18px;
      border-radius: 50px;
      text-decoration: none;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2), 0 2px 6px rgba(37, 211, 102, 0.3);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      cursor: pointer;
    }
    .reel-whatsapp-btn:hover {
      transform: translateY(-3px) scale(1.04);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28), 0 4px 10px rgba(37, 211, 102, 0.4);
      color: var(--wa-text, #ffffff);
    }
    .reel-whatsapp-icon {
      width: 26px;
      height: 26px;
      flex-shrink: 0;
    }
    .reel-whatsapp-label {
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.2px;
      white-space: nowrap;
    }

    /* Callout Tooltip */
    .reel-whatsapp-callout {
      background: #ffffff;
      color: #1a1a1a;
      padding: 8px 14px;
      border-radius: 12px;
      font-size: 13px;
      font-weight: 500;
      box-shadow: 0 4px 14px rgba(0,0,0,0.12);
      border: 1px solid #eeeeee;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      animation: reelWaFadeIn 0.4s ease forwards;
    }
    .reel-whatsapp-callout-close {
      cursor: pointer;
      font-size: 16px;
      color: #888888;
      padding: 0 2px;
      line-height: 1;
    }
    .reel-whatsapp-callout-close:hover {
      color: #1a1a1a;
    }

    /* Pulse Effect */
    .reel-wa-pulse {
      animation: reelWaPulseAnim 2s infinite;
    }
    @keyframes reelWaPulseAnim {
      0% {
        box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.6), 0 4px 16px rgba(0, 0, 0, 0.2);
      }
      70% {
        box-shadow: 0 0 0 14px rgba(37, 211, 102, 0), 0 4px 16px rgba(0, 0, 0, 0.2);
      }
      100% {
        box-shadow: 0 0 0 0 rgba(37, 211, 102, 0), 0 4px 16px rgba(0, 0, 0, 0.2);
      }
    }
    @keyframes reelWaFadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 749px) {
      .reel-whatsapp-label {
        display: none;
      }
      .reel-whatsapp-btn {
        padding: 12px;
        border-radius: 50%;
      }
      .reel-whatsapp-icon {
        width: 28px;
        height: 28px;
      }
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "WhatsApp Float Button",
  "target": "section",
  "settings": [
    {
      "type": "header",
      "content": "📱 WhatsApp Configuration"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "WhatsApp Phone Number (with Country Code)",
      "default": "+91 99478 77747",
      "info": "Example: +91 99478 77747 or 15551234567"
    },
    {
      "type": "text",
      "id": "default_message",
      "label": "Pre-filled Chat Message",
      "default": "Hi! I have a question about your products.",
      "info": "Automatic greeting message when customer clicks to chat."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label (Desktop)",
      "default": "Chat on WhatsApp",
      "info": "Leave empty for icon-only circle button."
    },
    {
      "type": "text",
      "id": "callout_text",
      "label": "Popup Welcome Bubble (Optional)",
      "default": "👋 Need help? Chat with us live!",
      "info": "Floating speech bubble above the button. Leave empty to hide."
    },
    {
      "type": "header",
      "content": "🎨 Positioning & Styling"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Corner Position",
      "options": [
        { "value": "right", "label": "Bottom Right" },
        { "value": "left", "label": "Bottom Left" }
      ],
      "default": "right"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Button Background Color",
      "default": "#25D366"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Icon & Text Color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "enable_pulse",
      "label": "Enable Glowing Pulse Animation",
      "default": true
    },
    {
      "type": "range",
      "id": "bottom_offset",
      "label": "Bottom Distance (px)",
      "min": 10,
      "max": 100,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "side_offset",
      "label": "Side Distance (px)",
      "min": 10,
      "max": 100,
      "step": 2,
      "default": 24
    }
  ]
}
{% endschema %}
