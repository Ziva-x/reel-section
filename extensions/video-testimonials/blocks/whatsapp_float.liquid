{% comment %}
  WhatsApp Floating Action Button by Reel Section
{% endcomment %}

{% assign phone = block.settings.phone_number | strip | replace: '+', '' | replace: ' ', '' | replace: '-', '' %}
{% assign message = block.settings.default_message | url_encode %}

{% if phone != blank %}
  <div
    class="reel-whatsapp-float-container reel-whatsapp-pos-{{ block.settings.position }}"
    id="reel-whatsapp-{{ block.id }}"
    style="
      --wa-bg: {{ block.settings.bg_color }};
      --wa-text: {{ block.settings.text_color }};
      --wa-bottom: {{ block.settings.bottom_offset }}px;
      --wa-side: {{ block.settings.side_offset }}px;
    "
  >
    {% if block.settings.callout_text != blank %}
      <a
        href="https://wa.me/{{ phone }}?text={{ message }}"
        target="_blank"
        rel="noopener noreferrer"
        class="reel-whatsapp-callout"
      >
        <span class="reel-whatsapp-callout-text">{{ block.settings.callout_text }}</span>
        <span class="reel-whatsapp-callout-close" onclick="event.preventDefault(); this.parentElement.style.display='none';">&times;</span>
      </a>
    {% endif %}

    <a
      href="https://wa.me/{{ phone }}?text={{ message }}"
      target="_blank"
      rel="noopener noreferrer"
      class="reel-whatsapp-btn {% if block.settings.enable_pulse %}reel-wa-pulse{% endif %}"
      aria-label="Chat on WhatsApp"
    >
